{
  "name": "P2-Doc-Change-Detector",
  "nodes": [
    {
      "id": "30000000-0000-4000-8000-000000000001",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {}
    },
    {
      "id": "30000000-0000-4000-8000-000000000002",
      "name": "Every 5 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 460],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "*/5 * * * *" }]
        }
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000003",
      "name": "Fetch Markdown",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [460, 380],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "method": "GET",
        "url": "https://raw.githubusercontent.com/jawwad-ali/self-healing-rag/main/corpus/source/cinder-analytics-docs.md",
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000004",
      "name": "Compute New Doc Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 380],
      "parameters": {
        "language": "javaScript",
        "jsCode": "function fnv1a(s) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    h ^= s.charCodeAt(i);\n    h = Math.imul(h, 0x01000193);\n  }\n  return (h >>> 0).toString(16).padStart(8, '0');\n}\n\nconst item = $input.first();\nconst text = item.json.data ?? item.json.body ?? (typeof item.json === 'string' ? item.json : JSON.stringify(item.json));\n\nreturn [{\n  json: {\n    source: 'corpus/source/cinder-analytics-docs.md',\n    content: text,\n    new_hash: fnv1a(text)\n  }\n}];"
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000005",
      "name": "Get/Insert Document",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 380],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH existing AS (\n  SELECT id, content_hash FROM rag.documents WHERE source = 'corpus/source/cinder-analytics-docs.md'\n), ins AS (\n  INSERT INTO rag.documents (source, title, content_hash, metadata)\n  SELECT 'corpus/source/cinder-analytics-docs.md',\n         'Cinder Analytics Platform — Product Documentation v3.2',\n         '',\n         '{\"version\":\"3.2\",\"format\":\"markdown\"}'::jsonb\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n  RETURNING id, content_hash\n)\nSELECT id, content_hash AS old_hash FROM existing\nUNION ALL\nSELECT id, content_hash AS old_hash FROM ins",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000006",
      "name": "Doc Hash Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1120, 380],
      "parameters": {
        "conditions": {
          "options": { "version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "hash-changed",
              "operator": { "type": "string", "operation": "notEquals" },
              "leftValue": "={{ $json.old_hash }}",
              "rightValue": "={{ $('Compute New Doc Hash').first().json.new_hash }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000007",
      "name": "Fetch Existing Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1340, 240],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chunk_index, content_hash\nFROM rag.chunks\nWHERE document_id = $1\nORDER BY chunk_index",
        "options": { "queryReplacement": "={{ $json.id }}" }
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000008",
      "name": "Split + Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 240],
      "parameters": {
        "language": "javaScript",
        "jsCode": "function fnv1a(s) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    h ^= s.charCodeAt(i);\n    h = Math.imul(h, 0x01000193);\n  }\n  return (h >>> 0).toString(16).padStart(8, '0');\n}\n\nconst text = $('Compute New Doc Hash').first().json.content;\nconst documentId = parseInt($('Get/Insert Document').first().json.id, 10);\nconst existingChunks = $input.all();\n\nconst existingByIndex = new Map();\nfor (const item of existingChunks) {\n  existingByIndex.set(Number(item.json.chunk_index), item.json.content_hash);\n}\n\nconst sections = text.split(/\\n(?=## )/);\nconst newChunks = [];\nlet idx = 0;\nfor (const sec of sections) {\n  const trimmed = sec.trim();\n  if (trimmed.length < 50) continue;\n  newChunks.push({\n    chunk_index: idx++,\n    content: trimmed,\n    content_hash: fnv1a(trimmed)\n  });\n}\n\nconst out = [];\nconst newIndexes = new Set();\nfor (const c of newChunks) {\n  newIndexes.add(c.chunk_index);\n  const existingHash = existingByIndex.get(c.chunk_index);\n  if (existingHash === undefined) {\n    out.push({ json: { action: 'INSERT', document_id: documentId, chunk_index: c.chunk_index, content: c.content, content_hash: c.content_hash } });\n  } else if (existingHash !== c.content_hash) {\n    out.push({ json: { action: 'CHANGED', document_id: documentId, chunk_index: c.chunk_index, content: c.content, content_hash: c.content_hash } });\n  }\n}\n\nfor (const [existIdx] of existingByIndex.entries()) {\n  if (!newIndexes.has(existIdx)) {\n    out.push({ json: { action: 'DELETE', document_id: documentId, chunk_index: existIdx } });\n  }\n}\n\nreturn out;"
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000009",
      "name": "Switch by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1780, 240],
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "is-insert", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.action }}", "rightValue": "INSERT" }], "combinator": "and" }, "renameOutput": true, "outputKey": "INSERT" },
            { "conditions": { "options": { "version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "is-changed", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.action }}", "rightValue": "CHANGED" }], "combinator": "and" }, "renameOutput": true, "outputKey": "CHANGED" },
            { "conditions": { "options": { "version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "id": "is-delete", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.action }}", "rightValue": "DELETE" }], "combinator": "and" }, "renameOutput": true, "outputKey": "DELETE" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000a",
      "name": "INSERT - Embed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [2000, 80],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'text-embedding-3-small', input: $json.content }) }}",
        "options": {}
      },
      "credentials": { "openAiApi": { "name": "OpenAi account" } }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000b",
      "name": "INSERT - Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 80],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const inserts = $('Split + Classify').all().filter(it => it.json.action === 'INSERT');\nconst embeddings = $input.all();\n\nreturn inserts.map((it, i) => ({\n  json: {\n    document_id: it.json.document_id,\n    chunk_index: it.json.chunk_index,\n    content: it.json.content,\n    content_hash: it.json.content_hash,\n    embedding: JSON.stringify(embeddings[i].json.data[0].embedding),\n    embedding_model: 'text-embedding-3-small'\n  }\n}));"
      }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000c",
      "name": "INSERT - Insert Chunk",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2440, 80],
      "parameters": {
        "schema": { "__rl": true, "mode": "list", "value": "rag", "cachedResultName": "rag" },
        "table": { "__rl": true, "mode": "list", "value": "chunks", "cachedResultName": "chunks" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [] },
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000d",
      "name": "CHANGED - Embed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [2000, 240],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'text-embedding-3-small', input: $json.content }) }}",
        "options": {}
      },
      "credentials": { "openAiApi": { "name": "OpenAi account" } }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000e",
      "name": "CHANGED - Pair",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 240],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const changes = $('Split + Classify').all().filter(it => it.json.action === 'CHANGED');\nconst embeddings = $input.all();\n\nfunction sqlEscape(s) {\n  return String(s).replace(/'/g, \"''\");\n}\n\nreturn changes.map((it, i) => ({\n  json: {\n    document_id: it.json.document_id,\n    chunk_index: it.json.chunk_index,\n    content: it.json.content,\n    content_sql: sqlEscape(it.json.content),\n    content_hash: it.json.content_hash,\n    embedding: JSON.stringify(embeddings[i].json.data[0].embedding)\n  }\n}));"
      }
    },
    {
      "id": "30000000-0000-4000-8000-00000000000f",
      "name": "CHANGED - Compute Cosine",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2440, 240],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT 1 - (embedding <=> '{{ $json.embedding }}'::vector) AS sim\nFROM rag.chunks\nWHERE document_id = {{ $json.document_id }}\n  AND chunk_index = {{ $json.chunk_index }}",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000010",
      "name": "CHANGED - sim < 0.95?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2660, 240],
      "parameters": {
        "conditions": {
          "options": { "version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "sim-low",
              "operator": { "type": "number", "operation": "lt" },
              "leftValue": "={{ Number($json.sim) }}",
              "rightValue": 0.95
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000011",
      "name": "CHANGED - Update Embedding",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2880, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE rag.chunks\nSET content = '{{ $('CHANGED - Pair').item.json.content_sql }}',\n    content_hash = '{{ $('CHANGED - Pair').item.json.content_hash }}',\n    embedding = '{{ $('CHANGED - Pair').item.json.embedding }}'::vector,\n    embedding_model = 'text-embedding-3-small',\n    updated_at = now()\nWHERE document_id = {{ $('CHANGED - Pair').item.json.document_id }}\n  AND chunk_index = {{ $('CHANGED - Pair').item.json.chunk_index }}",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000012",
      "name": "CHANGED - Update Content Only",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2880, 320],
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE rag.chunks\nSET content = '{{ $('CHANGED - Pair').item.json.content_sql }}',\n    content_hash = '{{ $('CHANGED - Pair').item.json.content_hash }}',\n    updated_at = now()\nWHERE document_id = {{ $('CHANGED - Pair').item.json.document_id }}\n  AND chunk_index = {{ $('CHANGED - Pair').item.json.chunk_index }}",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000013",
      "name": "DELETE - Delete Chunk",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2000, 480],
      "parameters": {
        "operation": "executeQuery",
        "query": "=DELETE FROM rag.chunks\nWHERE document_id = {{ $json.document_id }}\n  AND chunk_index = {{ $json.chunk_index }}",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "id": "30000000-0000-4000-8000-000000000014",
      "name": "Wait for All",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [3100, 280],
      "parameters": { "mode": "append", "numberInputs": 4 }
    },
    {
      "id": "30000000-0000-4000-8000-000000000015",
      "name": "Aggregate to One",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3320, 280],
      "parameters": {
        "language": "javaScript",
        "jsCode": "return [{\n  json: {\n    new_hash: $('Compute New Doc Hash').first().json.new_hash,\n    chunks_processed: $input.all().length\n  }\n}];"
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000016",
      "name": "Update Document Hash",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [3540, 280],
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE rag.documents\nSET content_hash = '{{ $json.new_hash }}',\n    updated_at = now()\nWHERE source = 'corpus/source/cinder-analytics-docs.md'",
        "options": {}
      },
      "credentials": { "postgres": { "name": "Postgres account" } }
    }
  ],
  "connections": {
    "Run Manually": { "main": [[{ "node": "Fetch Markdown", "type": "main", "index": 0 }]] },
    "Every 5 Min": { "main": [[{ "node": "Fetch Markdown", "type": "main", "index": 0 }]] },
    "Fetch Markdown": { "main": [[{ "node": "Compute New Doc Hash", "type": "main", "index": 0 }]] },
    "Compute New Doc Hash": { "main": [[{ "node": "Get/Insert Document", "type": "main", "index": 0 }]] },
    "Get/Insert Document": { "main": [[{ "node": "Doc Hash Changed?", "type": "main", "index": 0 }]] },
    "Doc Hash Changed?": { "main": [[{ "node": "Fetch Existing Chunks", "type": "main", "index": 0 }], []] },
    "Fetch Existing Chunks": { "main": [[{ "node": "Split + Classify", "type": "main", "index": 0 }]] },
    "Split + Classify": { "main": [[{ "node": "Switch by Action", "type": "main", "index": 0 }]] },
    "Switch by Action": {
      "main": [
        [{ "node": "INSERT - Embed", "type": "main", "index": 0 }],
        [{ "node": "CHANGED - Embed", "type": "main", "index": 0 }],
        [{ "node": "DELETE - Delete Chunk", "type": "main", "index": 0 }]
      ]
    },
    "INSERT - Embed": { "main": [[{ "node": "INSERT - Build Row", "type": "main", "index": 0 }]] },
    "INSERT - Build Row": { "main": [[{ "node": "INSERT - Insert Chunk", "type": "main", "index": 0 }]] },
    "INSERT - Insert Chunk": { "main": [[{ "node": "Wait for All", "type": "main", "index": 0 }]] },
    "CHANGED - Embed": { "main": [[{ "node": "CHANGED - Pair", "type": "main", "index": 0 }]] },
    "CHANGED - Pair": { "main": [[{ "node": "CHANGED - Compute Cosine", "type": "main", "index": 0 }]] },
    "CHANGED - Compute Cosine": { "main": [[{ "node": "CHANGED - sim < 0.95?", "type": "main", "index": 0 }]] },
    "CHANGED - sim < 0.95?": {
      "main": [
        [{ "node": "CHANGED - Update Embedding", "type": "main", "index": 0 }],
        [{ "node": "CHANGED - Update Content Only", "type": "main", "index": 0 }]
      ]
    },
    "CHANGED - Update Embedding": { "main": [[{ "node": "Wait for All", "type": "main", "index": 1 }]] },
    "CHANGED - Update Content Only": { "main": [[{ "node": "Wait for All", "type": "main", "index": 2 }]] },
    "DELETE - Delete Chunk": { "main": [[{ "node": "Wait for All", "type": "main", "index": 3 }]] },
    "Wait for All": { "main": [[{ "node": "Aggregate to One", "type": "main", "index": 0 }]] },
    "Aggregate to One": { "main": [[{ "node": "Update Document Hash", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  }
}
